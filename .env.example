# Copy to .env and fill in what you have. Every value here is optional in the
# sense that MirrorCap degrades to a clearly-labeled synthetic fallback when
# missing (see README "Environments" section) — but real demo credibility
# requires the Monad RPC URLs at minimum.

# --- Monad -------------------------------------------------------------
# Public/free RPC endpoints are listed at https://docs.monad.xyz/developer-essentials/network-information
# and https://docs.monad.xyz/developer-essentials/testnet — verify before use.
MONAD_TESTNET_RPC_URL=
MONAD_MAINNET_RPC_URL=

# --- Kuru ----------------------------------------------------------------
# Only needed if you want to override the default demo market
# (Monad testnet MON-USDC). Verify against https://docs.kuru.io/contracts/Contract-addresses
MONAD_TESTNET_MARKET_ADDRESS=0xa241896A7Dbe8a550D2E5fF7A914bB1989ceD2D9

# --- Nansen ----------------------------------------------------------------
# https://docs.nansen.ai/getting-started — without this, the Smart Money Feed
# shows one clearly-labeled synthetic trade instead of live data.
NANSEN_API_KEY=

# --- Privy -------------------------------------------------------------------
# https://dashboard.privy.io — App settings. Required for sign-in, trading
# wallets and copy execution. Login tokens are verified against the app's
# published JWKS, so no verification key is needed here.
# Also add Monad testnet (chain 10143) as a supported chain for the app.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Same app id, exposed to the browser for the login modal.
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- MirrorCap services ----------------------------------------------------
PORT=4000
MIRRORCAP_API_URL=http://localhost:4000
